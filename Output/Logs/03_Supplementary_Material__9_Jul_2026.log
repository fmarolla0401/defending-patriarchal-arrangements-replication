. 
. levelsof educ_3cat if estimation_sample == 1, local(ed_levels)
1 2 3

. foreach l of local ed_levels {
  2.     local lbl : label (educ_3cat) `l'
  3.     quietly gen educ_dummy_`l' = (educ_3cat == `l') if !missing(educ_3cat)
  4.     label variable educ_dummy_`l' "Education: `lbl'"
  5. }

. 
. levelsof oesch8_class if estimation_sample == 1, local(oesch_levels)
1 2 3 4 5 6 7 8 9

. foreach l of local oesch_levels {
  2.     local lbl : label (oesch8_class) `l'
  3.     quietly gen oesch_dummy_`l' = (oesch8_class == `l') if !missing(oesch8
> _class)
  4.     label variable oesch_dummy_`l' "Class: `lbl'"
  5. }

