. ********************************************************************************
. * FIGURE 3: Country Heterogeneity: Preference for Male Political Leadership Interaction
. ********************************************************************************
. 
. preserve

. 
. drop if missing(rr_vote, male, male_pol_lead, c_alphan)
(11,574 observations deleted)

. capture drop prr_available

. bysort c_alphan: egen prr_available = max(rr_vote)

. keep if prr_available == 1
(0 observations deleted)

. 
. tempname memhold

. tempfile results

. postfile `memhold' str2 c_alphan ame_w lo_w hi_w ame_m lo_m hi_m using `results'

. 
. levelsof c_alphan, local(countries)
`"AT"' `"BG"' `"CH"' `"CZ"' `"DE"' `"DK"' `"ES"' `"FI"' `"FR"' `"GR"' `"HR"' `"HU"' `"IT"' `"LT"' `"NL"' `"NO"' `"PL"' `"SE"' `"SI"' `"SK"'

. foreach c of local countries {
  2. 
.     capture noisily logit rr_vote i.male##c.male_pol_lead if c_alphan == "`c'", vce(robust)
  3. 
.     if _rc == 0 {
  4.         capture noisily margins, dydx(male_pol_lead) over(male) post
  5.         if _rc == 0 {
  6.             local b_w = _b[0.male]
  7.             local se_w = _se[0.male]
  8.             local lo_w = `b_w' - 1.96*`se_w'
  9.             local hi_w = `b_w' + 1.96*`se_w'
 10. 
.             local b_m = _b[1.male]
 11.             local se_m = _se[1.male]
 12.             local lo_m = `b_m' - 1.96*`se_m'
 13.             local hi_m = `b_m' + 1.96*`se_m'
 14.         }
 15.         else {
 16.             local b_w = .
 17.             local lo_w = .
 18.             local hi_w = .
 19.             local b_m = .
 20.             local lo_m = .
 21.             local hi_m = .
 22.         }
 23.         post `memhold' ("`c'") (`b_w') (`lo_w') (`hi_w') (`b_m') (`lo_m') (`hi_m')
 24.     }
 25. }

